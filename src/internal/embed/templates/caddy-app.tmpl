# {{.AppName}} Caddy Configuration
# This file will be included in the main Portico Caddyfile
# Portico Generated - Hash: {{.GeneratedHash}}

{{.Domain}} {
	# Reverse proxy to backend service via its portico-network alias (<app>-<service>).
	# Caddy already sets Host, X-Forwarded-For, X-Forwarded-Proto and X-Forwarded-Host.
	reverse_proxy {{.Upstream}}:{{.Port}} {
		header_up X-Real-IP {remote_host}
	}

	# Logging
	log {
		output file /home/portico/logs/apps/{{.AppName}}.log {
			# Readable by the portico user (Caddy runs as root in its container)
			mode 0644
		}
		format json
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
